LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_PREVIEW DIALOGEX 0, 0, 610, 470
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Directory Synchronization"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Left folder:", -1, 8, 9, 52, 10
    EDITTEXT IDC_LEFT, 62, 6, 236, 14, ES_AUTOHSCROLL
    LTEXT "&Right folder:", IDC_RIGHT_LABEL, 312, 9, 52, 10
    EDITTEXT IDC_RIGHT, 366, 6, 236, 14, ES_AUTOHSCROLL
    LTEXT "&Masks:", -1, 8, 29, 28, 10
    EDITTEXT IDC_MASK, 38, 26, 58, 14, ES_AUTOHSCROLL
    CONTROL "Sub&folders", IDC_RECURSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 104, 28, 71, 12
    CONTROL "By c&ontent", IDC_CONTENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 28, 70, 12
    CONTROL "&Ignore date", IDC_IGNORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 255, 28, 72, 12
    CONTROL "&Asymmetric", IDC_ASYMMETRIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 332, 28, 77, 12
    CONTROL "Panel &selection", IDC_SELECTED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 414, 28, 87, 12
    CONTROL "&Empty folders", IDC_EMPTY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 506, 28, 96, 12
    DEFPUSHBUTTON "&Compare", IDC_COMPARE, 8, 46, 70, 16
    PUSHBUTTON "S&top", IDC_STOP, 86, 46, 60, 16
    CONTROL "E&qual", IDC_EQUAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 158, 48, 49, 12
    CONTROL "&Different", IDC_DIFFERENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 209, 48, 58, 12
    CONTROL "Si&ngle-sided", IDC_SINGLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 269, 48, 74, 12
    CONTROL "Left to ri&ght", IDC_TORIGHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 345, 48, 79, 12
    CONTROL "Rig&ht to left", IDC_TOLEFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 426, 48, 79, 12
    CONTROL "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 70, 594, 318
    LTEXT "&Proposal:", IDC_PROPOSAL_LABEL, 8, 399, 39, 10
    COMBOBOX IDC_ACTION, 50, 396, 105, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply to highlighted ro&ws", IDC_APPLY, 162, 396, 110, 16
    PUSHBUTTON "Plan summar&y", IDC_SUMMARY, 280, 396, 90, 16
    PUSHBUTTON "Copy visible new files...", IDC_COPY_NEW, 378, 396, 115, 16
    PUSHBUTTON "Overwrite visible files...", IDC_OVERWRITE, 501, 396, 101, 16
    PUSHBUTTON "Sa&ve visible originals...", IDC_SAVE_ORIGINALS, 131, 419, 119, 16
    PUSHBUTTON "Delete visible files...", IDC_DELETE_FILES, 8, 419, 115, 16
    PUSHBUTTON "Close", IDCANCEL, 532, 437, 70, 16
    CONTROL "", IDC_STATUS, "msctls_statusbar32", SBARS_SIZEGRIP | SBARS_TOOLTIPS, 0, 454, 610, 16
END
IDD_INFORMATION DIALOGEX 0, 0, 300, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Directory Synchronization"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_INFO_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 286, 84
    LTEXT "&Notes:", IDC_INFO_NOTES_LABEL, 7, 96, 286, 8
    EDITTEXT IDC_INFO_NOTES, 7, 107, 286, 54, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "&Continue", IDOK, 137, 167, 76, 14
    DEFPUSHBUTTON "Cancel", IDCANCEL, 219, 167, 74, 14
END
IDD_APPEARANCE DIALOGEX 0, 0, 306, 201
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Preferences"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Appearance", -1, 7, 7, 60, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 73, 11, 226, 1
    CONTROL "Show action &labels", IDC_ACTION_LABELS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 22, 140, 12
    LTEXT "&Equal:", -1, 7, 45, 88, 10
    PUSHBUTTON "...", IDC_COLOR_BUTTON_FIRST, 99, 42, 26, 16
    CONTROL "", IDC_COLOR_SAMPLE_FIRST, "Static", SS_OWNERDRAW, 129, 42, 18, 16
    LTEXT "&Different:", -1, 7, 63, 88, 10
    PUSHBUTTON "...", 451, 99, 60, 26, 16
    CONTROL "", 461, "Static", SS_OWNERDRAW, 129, 60, 18, 16
    LTEXT "Copy to &right:", -1, 7, 81, 88, 10
    PUSHBUTTON "...", 452, 99, 78, 26, 16
    CONTROL "", 462, "Static", SS_OWNERDRAW, 129, 78, 18, 16
    LTEXT "Copy to le&ft:", -1, 7, 99, 88, 10
    PUSHBUTTON "...", 453, 99, 96, 26, 16
    CONTROL "", 463, "Static", SS_OWNERDRAW, 129, 96, 18, 16
    LTEXT "&Skip:", -1, 159, 45, 88, 10
    PUSHBUTTON "...", 454, 251, 42, 26, 16
    CONTROL "", 464, "Static", SS_OWNERDRAW, 281, 42, 18, 16
    LTEXT "Dele&te:", -1, 159, 63, 88, 10
    PUSHBUTTON "...", 455, 251, 60, 26, 16
    CONTROL "", 465, "Static", SS_OWNERDRAW, 281, 60, 18, 16
    LTEXT "Decision / &blocked:", -1, 159, 81, 88, 10
    PUSHBUTTON "...", 456, 251, 78, 26, 16
    CONTROL "", 466, "Static", SS_OWNERDRAW, 281, 78, 18, 16
    PUSHBUTTON "Restore defa&ults", IDC_COLOR_RESET, 159, 96, 100, 16
    LTEXT "Other settings", -1, 7, 123, 75, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 88, 127, 211, 1
    CONTROL "&Keep originals", IDC_KEEP_ORIGINALS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 139, 140, 12
    LTEXT "Rec&overy folder:", IDC_RECOVERY_LABEL, 7, 160, 76, 10
    EDITTEXT IDC_RECOVERY_ROOT, 86, 157, 213, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 169, 181, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 237, 181, 62, 14
END
STRINGTABLE
BEGIN
    IDS_APPEARANCE "Appearance"
    IDS_TIP_MASK "File masks, for example *.txt; separate masks with spaces or semicolons. Use | before exclusions."
    IDS_TIP_KEEP "Save verified originals before overwrites and deletions. Uses additional disk space. When off, no new recovery copies are created; existing backups are kept."
    IDS_TIP_DELETE "All visible eligible right-only files in asymmetric mode. Highlighting does not limit the operation. Hidden and Skip rows are excluded. Folders are kept."
    IDS_TIP_SCOPE "All visible eligible proposals, regardless of highlighted rows. Hidden and Skip rows are excluded. Each operation requires confirmation."
    IDS_TIP_SELECTION "Scan the selection originally captured from the file panels, not highlighted preview rows."
    IDS_TIP_EMPTY "Include empty folders in the preview. Folder deletion is not supported."
    IDS_COLOR_FIRST "Equal"
    441 "Different"
    442 "Copy to right"
    443 "Copy to left"
    444 "Skip"
    445 "Delete"
    446 "Decision / blocked"
    IDS_UI_FIELD "Field"
    IDS_UI_VALUE "Value"
    IDS_UI_PLAN "Plan summary"
    IDS_UI_COPY_CONFIRM "Confirm new-file copies"
    IDS_UI_COPY_RESULT "New-file copy result"
    IDS_UI_SAVE_CONFIRM "Confirm saving originals"
    IDS_UI_SAVE_RESULT "Recovery result"
    IDS_UI_OVERWRITE_CONFIRM "Confirm file overwrites"
    IDS_UI_OVERWRITE_RESULT "Overwrite result"
    IDS_UI_DELETE_CONFIRM "Confirm file deletion"
    IDS_UI_DELETE_RESULT "File deletion result"
    IDS_UI_FILES "Eligible visible files"
    IDS_UI_BYTES "New main data (bytes)"
    IDS_UI_ORIGINAL_BYTES "Original main data (bytes)"
    IDS_UI_OMITTED "Other visible proposals omitted"
    IDS_UI_COPIED "Copied and verified"
    IDS_UI_REPLACED "Replaced and verified"
    IDS_UI_DELETED "Deleted"
    IDS_UI_ERRORS "Errors / cancelled items"
    IDS_UI_PENDING "Not started"
    IDS_UI_LOGGED "Result records written"
    IDS_UI_RECOVERY "Keep originals"
    IDS_UI_ON "ON"
    IDS_UI_OFF "OFF - no recovery copy from this run"
    IDS_UI_RECOVERED "Originals saved / selected"
    IDS_UI_MANIFEST "Recovery manifest"
    IDS_UI_JOURNAL "Execution journal"
    IDS_UI_COPY_POLICY "Copies data, the supported ADS set and metadata, then verifies them. Files inherit destination permissions. Required parent folders may be created. Existing targets are never replaced. Stop preserves completed files; empty created parents may remain."
    IDS_UI_SAVE_POLICY "Creates independent, verified copies and a manifest in an existing recovery folder outside both trees. Originals remain unchanged; no proposal is executed. Recovery copies inherit the recovery folder permissions. Stop preserves completed copies."
    IDS_UI_OVERWRITE_POLICY "New targets and deletions are omitted. Replaces existing file names after staging and verification, preserving original target permissions. Read-only targets are refused without attribute changes. Stop preserves completed replacements; there is no automatic rollback."
    IDS_UI_DELETE_POLICY "Only visible Delete on right proposals for right-only files in asymmetric mode are eligible. Folders are never removed, even when empty. The Recycle Bin is not used. Read-only files are refused without attribute changes. Stop preserves completed deletions; there is no automatic rollback."
    IDS_UI_RESULT_NOTE "Inspect the result, then Compare again before another operation. Compare rebuilds proposals; reapply manual Skip if needed. Ctrl+C copies a selected value; Ctrl+Shift+C copies the full summary."
    IDS_UI_COPY_VALUE "Copy &value\tCtrl+C"
    IDS_UI_COPY_ALL "Copy &all\tCtrl+Shift+C"
    IDS_UI_CLIPBOARD_ERROR "Could not copy the text to the clipboard."
    IDS_UI_ADS_NOTE "Byte counts exclude alternate data streams (ADS)."
    IDS_UI_SCOPE_LABEL "Scope"
    IDS_UI_SCOPE_VALUE "All visible eligible proposals"
    IDS_UI_SCOPE_NOTE "Highlighted rows do not limit these commands. Hidden and Skip rows are excluded. Run each kind of operation separately."
    IDS_UI_PLAN_NOTE "Proposals only, for all visible rows regardless of highlighting. Run copies, overwrites and deletions separately; each requires confirmation. Copy counts and bytes include both new and existing targets. Only right-only files can be deleted in asymmetric mode; folders are kept. Compare rebuilds proposals; reapply manual Skip if needed."
    IDS_UI_TO_RIGHT "Copies to right (count / main bytes)"
    IDS_UI_TO_LEFT "Copies to left (count / main bytes)"
    IDS_UI_DELETE_RIGHT "Proposed deletions on right (includes folders)"
    IDS_UI_UNRESOLVED "Visible unresolved"
    IDS_UI_BLOCKED "Blocked / conflicts (all rows)"
    IDS_UI_HIDDEN "Hidden rows"
    IDS_UI_COPY_BYTES "Main data (bytes; ADS additional)"
    IDS_UI_READY "Ready"
    IDS_UI_SCAN "Scanning"
    IDS_UI_COMPARE "Comparing content"
    IDS_UI_VALIDATE "Checking plan"
    IDS_UI_TRANSFER "Item %llu / %llu"
    IDS_UI_TRANSFER_STATS "Copied %llu B | verified %llu B | complete %llu"
    IDS_UI_SCAN_STATS "Scanned %llu | compared %llu"
    IDS_UI_READ_STATS "Read %llu B | scanned %llu | pairs %llu"
    IDS_UI_ROWS "Rows %llu | visible %llu | hidden %llu | blocked %llu"
    IDS_UI_FINISHED "Run finished - inspect result and Compare again"
    IDS_UI_STOPPING "Stopping - waiting for the current operation"
    IDS_UI_SUMMARY "OK"
    IDS_UI_OP_COPY "Copying / verifying"
    IDS_UI_OP_SAVE "Saving / verifying originals"
    IDS_UI_OP_OVERWRITE "Backup / overwrite"
    IDS_UI_OP_DELETE "Backup / delete"
    IDS_UI_RECOVERY_FOLDER "Recovery folder"
    IDS_UI_COMPLETE "Comparison complete"
    IDS_UI_ERROR_DETAILS "Error / staging details"
    IDS_UI_START_COPY "Copy files"
    IDS_UI_START_SAVE "Save originals"
    IDS_UI_START_OVERWRITE "Overwrite files"
    IDS_UI_START_DELETE "Delete files"
    IDS_DELETE_PROGRESS "Backup/delete: item %llu of %llu; copied %llu bytes; Verify read %llu bytes; complete %llu"
    IDS_DELETE_AGAIN "Deletion run finished. Inspect the result and compare again before any further action."
    IDS_DELETE_EMPTY "No visible Delete on right proposal is a supported right-only file from an asymmetric comparison. Nothing to delete."
    IDS_DELETE_CONFIRM "Delete %llu visible right-only files?\n\nOriginal main data: %llu bytes (ADS are additional).\nOther visible non-skip proposals omitted: %llu.\n\nOnly explicit Delete on right proposals from asymmetric comparison are included. Folders are never removed, even when empty. This does not use the Recycle Bin. Read-only files are refused without changing attributes. Stop preserves completed deletions; there is no automatic rollback."
    IDS_DELETE_ON "Keeping originals: ON. All originals must be independently saved, verified and logged outside both trees before any deletion."
    IDS_DELETE_OFF "Keeping originals: OFF. Deleted data and ADS will have NO recovery copy from this run."
    IDS_DELETE_RESULT "File deletion result\n\nDeleted: %llu\nErrors/cancelled items: %llu\nNot started: %llu\nOther visible proposals omitted: %llu\n\nCompare again."
    IDS_DELETE_FAILED "The deletion worker failed. Some files may have been deleted. Inspect the right tree and any recovery folder before retrying."
    IDS_DELETE_INCOMPLETE "The run is incomplete. Completed deletions remain; inspect the result and any manifests."
    IDS_DELETE_RECOVERY_ERROR "Preserving an original failed; no deletions were started."
    IDS_OVERWRITE_PROGRESS "Backup/overwrite: transfer %llu of %llu; copied %llu bytes; Verify read %llu bytes; complete %llu"
    IDS_OVERWRITE_AGAIN "Overwrite run finished. Inspect the result and compare again before any further action."
    IDS_OVERWRITE_EMPTY "No visible copy proposal has an existing supported file on both sides. Nothing to overwrite."
    IDS_OVERWRITE_CONFIRM "Overwrite existing target files for %llu visible copy proposals?\n\nNew main data: %llu bytes (ADS are additional).\nOriginal main data: %llu bytes (additional recovery space when enabled).\nOther visible non-skip proposals omitted: %llu.\n\nNew targets and deletions are omitted. Preserves original target permissions; replaces the file name after staging and Verify. Read-only targets are refused without changing their attributes. Stop preserves completed replacements; there is no automatic rollback."
    IDS_OVERWRITE_ON "Keeping originals: ON. All originals must be independently saved, verified and logged before any overwrite."
    IDS_OVERWRITE_OFF "Keeping originals: OFF. Overwritten data and old ADS will have NO recovery copy from this run."
    IDS_OVERWRITE_RESULT "Overwrite result\n\nReplaced and verified: %llu\nErrors/cancelled items: %llu\nNot started: %llu\nOther visible proposals omitted: %llu\n\nCompare again."
    IDS_OVERWRITE_PUBLISHED_ERROR "The replacement was published, but final checks failed. It remains in place. Inspect the target and any recovery copy."
    IDS_OVERWRITE_FAILED "The overwrite worker failed. Some files may have been replaced. Inspect both trees and any recovery folder before retrying."
    IDS_OVERWRITE_RECOVERY "Original copies verified and logged: %llu of %llu"
    IDS_OVERWRITE_INCOMPLETE "The run is incomplete. Completed replacements remain; inspect the result and any manifests."
    IDS_OVERWRITE_RECOVERY_ERROR "Preserving an original failed; no overwrites were started."
    IDS_SETTINGS_FAILED "The recovery setting could not be saved. It remains in effect for this session only."
    IDS_RECOVERY_DISABLED "Keeping originals is disabled. Enable Keep originals in the plugin preferences to create recovery copies."
    IDS_RECOVERY_SPACE_ON "Recovery copies use additional disk space."
    IDS_RECOVERY_SPACE_OFF "Off: no recovery copies; existing backups are kept."
    IDS_SAVE_PROGRESS "Saving originals: file %llu of %llu; copied %llu bytes; Verify read %llu bytes; complete %llu"
    IDS_SAVE_AGAIN "Recovery run finished. Originals unchanged. Compare again before any further action."
    IDS_SAVE_EMPTY "No visible copy proposal has an existing, supported file on both sides. Nothing to save."
    IDS_SAVE_ROOT "Set an existing recovery folder outside both compared trees in the plugin preferences."
    IDS_SAVE_CONFIRM "Save original target files for %llu visible copy proposals?\n\nMain data: %llu bytes (ADS are additional).\nOther visible non-skip proposals omitted: %llu.\n\nCreates independent, verified copies and a UTF-8 manifest in the recovery folder below. Originals remain unchanged; no proposal is executed. The folder must already exist outside both compared trees. Recovery copies inherit its permissions. Stop preserves completed copies.\n\n"
    IDS_SAVE_RESULT "Recovery copies\n\nCopied and verified: %llu\nErrors/cancelled items: %llu\nNot started: %llu\nResult records written: %llu\nOther visible proposals omitted: %llu\n\nOriginals unchanged. Compare again.\n\n"
    IDS_SAVE_INCOMPLETE "The run is incomplete. Inspect the manifest and saved files; do not treat it as a completed recovery set."
    IDS_SAVE_FAILED "The recovery worker failed. Originals remain unchanged. Inspect the recovery folder and manifest before retrying."
    IDS_SAVE_PUBLISHED_ERROR "The recovery copy was published, but final checks failed. Inspect it before restoring."
    IDS_NAME "Directory Synchronization"
    IDS_DESCRIPTION "Compare and synchronize Windows folders. Separately copy, overwrite or delete right-only files with optional recovery. Folders are kept."
    IDS_MENU "Directory synchronization..."
    IDS_INPUT_ERROR "Both panels must contain Windows folders with complete paths and decodable selected names. The current SDK cannot provide a usable input for these panels."
    IDS_SCAN "Scanning: %llu entries; compared: %llu"
    IDS_READING "Comparing content: %llu bytes read (both sides); scanned: %llu; completed pairs: %llu"
    IDS_VALIDATING "Checking preview against current folders: %llu entries"
    IDS_STALE "This preview is unavailable or has changed. Compare again before any further action."
    IDS_DONE "Complete: %llu rows; visible: %llu; hidden: %llu; blocked/conflicts: %llu"
    IDS_CANCELLED "Cancelled. Partial results contain no actionable proposals."
    IDS_FAILED "Comparison failed. Results have been discarded."
    IDS_SUMMARY "Proposals only. Copy new files, Overwrite files and Delete files each require a separate confirmation. Only right-only files can be deleted in asymmetric mode; folders are kept.\n\nVisible proposed copies to right: %llu (%llu bytes)\nVisible proposed copies to left: %llu (%llu bytes)\nVisible proposed deletions on right: %llu\nVisible unresolved: %llu\nBlocked/conflicts (all rows): %llu\nHidden rows: %llu"
    IDS_COPY_PROGRESS "Copy/check: file %llu of %llu; copied %llu bytes; Verify read %llu bytes; complete %llu"
    IDS_COPY_AGAIN "Copy run finished. Compare again before any further action."
    IDS_COPY_EMPTY "No visible file action has a missing target. Existing targets, deletions, empty-folder actions and unresolved items cannot be executed."
    IDS_COPY_CONFIRM "Visible files to copy to NEW targets: %llu.\n\nMain data: %llu bytes (ADS are additional).\nOther visible non-skip proposals omitted: %llu.\n\nCopies and verifies data and supported metadata. Files inherit destination permissions. Required parent folders may be created. Existing targets will never be replaced. Stop preserves completed files; empty created parents may remain."
    IDS_COPY_RESULT "New-file copy result\n\nCopied and verified: %llu\nErrors/cancelled items: %llu\nNot started: %llu\nOther visible proposals omitted: %llu\n\nCompare again."
    IDS_COPY_ERROR "Windows error: "
    IDS_COPY_PUBLISHED_ERROR "The new target was published, but final verification failed. It was left in place."
    IDS_COPY_REMAINDER "Staging requires manual inspection: "
    IDS_COPY_STOPPED "Stopped. Completed new files remain in place."
    IDS_COPY_FAILED "The copy worker failed. Completed files may remain. Compare again and inspect the destination before retrying."
    IDS_SELECT_ROW "Select one or more rows first. Blocked and conflicting rows cannot receive actions."
    IDS_HELP "Choose the two Windows folders and Compare. Scan panel selection uses the union of the original panel selections and locks the original roots. Subfolders adds deeper levels; selected folders include direct children.\n\nMasks are separated by spaces or semicolons; quote names containing spaces. Use | before exclusions, a leading backslash to anchor to the root, and ** for any depth. Examples: *.txt | selB\\ or selA\\**\\*.txt. Regex and saved searches are not supported.\n\nHighlight rows and use Apply to highlighted rows to change their proposals, then review Plan summary. Highlighting does not restrict Copy, Overwrite, Delete or Save originals: each command uses all visible eligible proposals. Hidden and Skip rows are excluded. Run each kind of operation separately. Only visible actions enter that summary; blocked/conflicting rows always stay visible. Copy new files executes only visible file copies with missing targets after a separate confirmation. Existing targets, deletions and empty-folder actions are omitted.\n\nKeep originals is enabled by default and can be switched off. This setting and the recovery folder are remembered for this plugin. Disabling it creates no recovery copies and leaves existing backups in place. Delete files separately confirms visible Delete on right proposals from asymmetric comparison. Only supported files absent on the left are eligible. Folders are never deleted. The confirmation states recovery ON/OFF; when ON all originals must first be saved and verified. When OFF deleted data and ADS have no recovery copy. The Recycle Bin is not used. Read-only files are refused.\n\nOverwrite files separately confirms replacement of visible existing-file targets. The confirmation states whether recovery is ON or OFF. When ON, all original targets must first be saved and verified outside both trees. When OFF, overwritten data and old ADS have no recovery copy from this run. Replacements keep original target permissions. Read-only targets are refused. Stop leaves completed replacements in place.\n\nSave originals separately saves original target files for visible copy proposals with an existing file on both sides. Set an existing recovery folder outside both compared trees in the plugin preferences. This creates independent verified copies and a manifest; originals remain unchanged and no proposal is executed. Permissions inherit from the recovery folder.\n\nData and metadata are verified; Stop preserves completed files. Compare again after a run. Compare rebuilds proposals; reapply manual Skip if needed."
