#pragma code_page(65001)
#define DIRSYNC_CZECH
#include <winres.h>
#include <commctrl.h>
#include "../resource.h"
#include "../versinfo.rh2"
#include "czech-versinfo.rc2"
LANGUAGE LANG_CZECH, SUBLANG_DEFAULT
IDD_PREVIEW DIALOGEX 0, 0, 610, 470
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Synchronizace adresářů"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Levý adresář:", -1, 8, 9, 52, 10
    EDITTEXT IDC_LEFT, 62, 6, 218, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_LEFT, 284, 6, 14, 14
    LTEXT "&Pravý adresář:", IDC_RIGHT_LABEL, 312, 9, 52, 10
    EDITTEXT IDC_RIGHT, 366, 6, 218, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_RIGHT, 588, 6, 14, 14
    LTEXT "&Masky:", -1, 8, 29, 28, 10
    EDITTEXT IDC_MASK, 38, 26, 45, 14, ES_AUTOHSCROLL
    CONTROL "P&odadresáře", IDC_RECURSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 91, 28, 69, 12
    CONTROL "O&bsah", IDC_CONTENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 28, 80, 12
    CONTROL "&Ignorovat datum", IDC_IGNORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 248, 28, 82, 12
    CONTROL "&Asymetricky", IDC_ASYMMETRIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 91, 41, 69, 12
    CONTROL "&Výběr panelů", IDC_SELECTED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 41, 80, 12
    CONTROL "Prázdné adresář&e", IDC_EMPTY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 248, 41, 82, 12
    CONTROL "S&hodné", IDC_EQUAL, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 352, 26, 14, 14
    CONTROL "Roz&dílné", IDC_DIFFERENT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 370, 26, 14, 14
    CONTROL "&Jednostranné", IDC_SINGLE, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 388, 26, 14, 14
    CONTROL "Doprava (&G)", IDC_TORIGHT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 352, 46, 14, 14
    CONTROL "Doleva (&K)", IDC_TOLEFT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 370, 46, 14, 14
    DEFPUSHBUTTON "Po&rovnat", IDC_COMPARE, 430, 26, 88, 14, WS_GROUP
    CONTROL "Zas&tavit porovnání", IDC_STOP, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 518, 26, 14, 14
    PUSHBUTTON "&Synchronizovat...", IDC_SYNCHRONIZE, 430, 46, 88, 14, WS_GROUP
    CONTROL "&Zastavit synchronizaci", IDC_STOP_SYNC, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 518, 46, 14, 14
    PUSHBUTTON "Nastavení...", IDC_SETTINGS, 546, 26, 56, 14
    PUSHBUTTON "Zavřít", IDCANCEL, 546, 46, 56, 14
    CONTROL "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 70, 610, 384
    CONTROL "", IDC_STATUS, "msctls_statusbar32", SBARS_SIZEGRIP | SBARS_TOOLTIPS, 0, 454, 610, 16
END
IDD_INFORMATION DIALOGEX 0, 0, 300, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Synchronizace adresářů"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_INFO_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 286, 84
    LTEXT "&Poznámky:", IDC_INFO_NOTES_LABEL, 7, 96, 286, 8
    EDITTEXT IDC_INFO_NOTES, 7, 107, 286, 54, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "OK", IDOK, 137, 167, 76, 14
    DEFPUSHBUTTON "Storno", IDCANCEL, 219, 167, 74, 14
END
IDD_APPEARANCE DIALOGEX 0, 0, 306, 287
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Nastavení"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Vzhled", -1, 7, 7, 60, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 73, 11, 226, 1
    CONTROL "&Zobrazovat popisky operací", IDC_ACTION_LABELS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 22, 140, 12
    LTEXT "&Shoda:", -1, 7, 45, 88, 10
    PUSHBUTTON "...", IDC_COLOR_BUTTON_FIRST, 99, 42, 26, 16
    CONTROL "", IDC_COLOR_SAMPLE_FIRST, "Static", SS_OWNERDRAW, 129, 42, 18, 16
    LTEXT "&Rozdíl:", -1, 7, 63, 88, 10
    PUSHBUTTON "...", 451, 99, 60, 26, 16
    CONTROL "", 461, "Static", SS_OWNERDRAW, 129, 60, 18, 16
    LTEXT "Kopírovat do&prava:", -1, 7, 81, 88, 10
    PUSHBUTTON "...", 452, 99, 78, 26, 16
    CONTROL "", 462, "Static", SS_OWNERDRAW, 129, 78, 18, 16
    LTEXT "Kopírovat do&leva:", -1, 7, 99, 88, 10
    PUSHBUTTON "...", 453, 99, 96, 26, 16
    CONTROL "", 463, "Static", SS_OWNERDRAW, 129, 96, 18, 16
    LTEXT "Přes&kočit:", -1, 159, 45, 88, 10
    PUSHBUTTON "...", 454, 251, 42, 26, 16
    CONTROL "", 464, "Static", SS_OWNERDRAW, 281, 42, 18, 16
    LTEXT "S&mazat:", -1, 159, 63, 88, 10
    PUSHBUTTON "...", 455, 251, 60, 26, 16
    CONTROL "", 465, "Static", SS_OWNERDRAW, 281, 60, 18, 16
    LTEXT "Roz&hodnutí / blokováno:", -1, 159, 81, 88, 10
    PUSHBUTTON "...", 456, 251, 78, 26, 16
    CONTROL "", 466, "Static", SS_OWNERDRAW, 281, 78, 18, 16
    PUSHBUTTON "Obnovit výchozí &barvy", IDC_COLOR_RESET, 179, 102, 120, 16
    LTEXT "Sloupce", -1, 7, 123, 60, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 73, 127, 226, 1
    CONTROL "Velikost vlevo", 520, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 136, 140, 12
    CONTROL "Změněno vlevo", 521, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 149, 140, 12
    CONTROL "Velikost vpravo", 522, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 162, 140, 12
    CONTROL "Změněno vpravo", 523, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 175, 140, 12
    CONTROL "Stav", 524, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 136, 140, 12
    CONTROL "Důvod", 525, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 149, 140, 12
    CONTROL "Chyba", 526, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 162, 140, 12
    CONTROL "Uvádět stranu v záhlaví", IDC_SIDE_NAMES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 175, 140, 12
    CONTROL "Zobrazovat velikost relativně", IDC_RELATIVE_SIZES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 190, 140, 12
    CONTROL "Zobrazovat čas relativně", IDC_RELATIVE_TIMES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 190, 140, 12
    LTEXT "Další nastavení", -1, 7, 209, 75, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 88, 213, 211, 1
    CONTROL "&Uchovat originály", IDC_KEEP_ORIGINALS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 225, 140, 12
    LTEXT "Adresář &obnovy:", IDC_RECOVERY_LABEL, 7, 246, 76, 10
    EDITTEXT IDC_RECOVERY_ROOT, 86, 243, 195, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_RECOVERY, 285, 243, 14, 14
    DEFPUSHBUTTON "OK", IDOK, 169, 267, 62, 14
    PUSHBUTTON "Storno", IDCANCEL, 237, 267, 62, 14
END
#include "czech-strings.rc2"
